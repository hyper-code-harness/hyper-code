# dependencies (bun install)
node_modules

# output
out
dist
*.tgz
# Xcode build output. Every build lane makes its own directory, and they are
# hundreds of megabytes each — one glob instead of naming them as they appear.
mobile/.derived*/
mobile/.archive/
mobile/.runtime/

mobile/**/*.xcuserstate
mobile/**/xcuserdata/
# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

.env.bak.*
# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# Runtime state
.runtime/
.hyper/_runtime
# Private immutable tool results (including nested instance roots)
**/.hyper/results/
.hyper/_test_*
.hyper/_tmp_*
# createFunction staging (deleted after each call)
src/_tmp_authoring/
.hyper/tmp_*
# scratch for agents and tests: temp files, drafts, backups (see SYSTEM_PROMPT_CORE)
.hyper/tmp/
# browser.screenshot scratch output
.hyper/browser-*.png
.kimi-results
.claude/

# Generated by procs.dev.genTypes on every boot and on every watcher reload.
# Kept out of git because its import paths describe THIS machine: a locally
# mounted plugin resolves to ~/.hyper/user/<name>, which exists for nobody else
# and drags files that tsconfig excludes back into the type-check. Regenerate it
# with `bun script/cli.ts types`.
src/ctx_ns.d.ts

# What THIS machine mounts on top of the project. The modules the repo ships
# are declared in package.json under `procs.modules`; this file is the local
# overlay, and modules.add writes here. It holds absolute paths into $HOME, so
# committing it made one person's mounts everyone's — and a fresh clone tried
# to load plugins that only exist on that laptop.
workspace.json

# Test fixtures — written at runtime by src/files/*.test.ts. Kept OUT of the
# scanned roots (src/, .hyper/) so they can never leak into ctx.fns / ctx_ns.d.ts.
.test-tmp/
.runtime-tw/
plugins/*/.secrets

# local scratch: db dumps, throwaway scripts (never commit transcripts)
tmp/

# Excalidraw drawings (local user content)
drawings/

# local scratch: screenshots, debug dumps, session cookies, research notes
.hyper/*.png
.hyper/*.svg
.hyper/cookie.json
.hyper/htmx-migration/
/artifacts/
/data/
/research/
/doonto/
/dhh-rails-world-2026-keynote-transcript.md

# Private instance overlay; never publish local functions or artifacts.
/.hyper/

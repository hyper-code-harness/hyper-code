{
  "manifest_version": 3,
  "name": "Hyper canvas frames",
  "version": "0.3.0",
  "description": "Lets the Hyper canvas show sites that forbid being framed (X-Frame-Options, CSP frame-ancestors) and keeps their logins working \u2014 only inside Hyper tabs.",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.hyper-mesh.xyz/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}

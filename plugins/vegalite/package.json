{
  "name": "vegalite",
  "private": true,
  "type": "module",
  "procs": {
    "configuration": {
      "settings": [
        "vegalite.allowRemoteData",
        "vegalite.allowSqlData",
        "vegalite.dataRoot",
        "vegalite.maxDataBytes"
      ]
    },
    "src": "src",
    "label": "Vega-Lite",
    "icon": "ph-chart-bar",
    "optional": true,
    "description": "Render charts as inline SVG from Vega-Lite specifications and local CSV, JSON, or NDJSON data."
  },
  "dependencies": {
    "vega": "^6.1.2",
    "vega-lite": "^6.4.3"
  }
}

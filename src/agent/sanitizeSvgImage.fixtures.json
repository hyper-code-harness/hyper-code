ns-serif\" font-size=\"11px\" fill=\"#717684\" opacity=\"1\">0.5</text><text text-anchor=\"end\" transform=\"translate(-10,123)\" font-family=\"Inter, ui-sans-serif, system-ui, sans-serif\" font-size=\"11px\" fill=\"#717684\" opacity=\"1\">1.0</text><text text-anchor=\"end\" transform=\"translate(-10,63)\" font-family=\"Inter, ui-sans-serif, system-ui, sans-serif\" font-size=\"11px\" fill=\"#717684\" opacity=\"1\">1.5</text><text text-anchor=\"end\" transform=\"translate(-10,3)\" font-family=\"Inter, ui-sans-serif, system-ui, sans-serif\" font-size=\"11px\" fill=\"#717684\" opacity=\"1\">2.0</text></g><g class=\"mark-rule role-axis-domain\" pointer-events=\"none\"><line transform=\"translate(0,240)\" x2=\"0\" y2=\"-240\" stroke=\"#CCCED4\" stroke-width=\"1\" opacity=\"1\"/></g><g class=\"mark-text role-axis-title\" pointer-events=\"none\"><text text-anchor=\"middle\" transform=\"translate(-40,120) rotate(-90) translate(0,-3)\" font-family=\"Inter, ui-sans-serif, system-ui, sans-serif\" font-size=\"12px\" font-weight=\"500\" fill=\"#1D2331\" opacity=\"1\">y</text></g></g><path class=\"foreground\" aria-hidden=\"true\" d=\"\" pointer-events=\"none\" display=\"none\"/></g></g><g class=\"mark-group role-scope\" role=\"graphics-object\" aria-roledescription=\"group mark container\"><g transform=\"translate(1.1999999999999993,0)\"><path class=\"background\" aria-hidden=\"true\" d=\"M2,0L19.6,0C20.703830048988003,0,21.6,0.896169951012,21.6,2L21.6,240C21.6,240,21.6,240,21.6,240L0,240C0,240,0,240,0,240L0,2C0,0.896169951012,0.896169951012,0,2,0Z\"/><g clip-path=\"url(#clip3)\"><g class=\"mark-group role-scope\" role=\"graphics-object\" aria-roledescription=\"group mark container\"><g transform=\"translate(0,0)\"><path class=\"background\" aria-hidden=\"true\" d=\"M0,0h21.6v0h-21.6Z\"/><g><g class=\"mark-rect role-mark marks\" role=\"graphics-object\" aria-roledescription=\"rect mark container\"><path aria-label=\"x: A; y: 2\" role=\"graphics-symbol\" aria-roledescription=\"ba